rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    function ownerFrom(data) {
      return data.uid != null ? data.uid :
        data.ownerUid != null ? data.ownerUid :
        data.userUid != null ? data.userUid :
        data.creatorUid != null ? data.creatorUid :
        data.createdByUid != null ? data.createdByUid :
        null;
    }

    function isOwnerUid(uid) {
      return uid != null && signedIn() && request.auth.uid == uid;
    }

    function ownerMatchesResource() {
      return resource != null && isOwnerUid(ownerFrom(resource.data));
    }

    function ownerMatchesRequest() {
      return request.resource != null && isOwnerUid(ownerFrom(request.resource.data));
    }

    function asList(value) {
      return value is list ? value : [];
    }

    function hasMember(listValue) {
      return signedIn() && asList(listValue).hasAny([request.auth.uid]);
    }

    function isChatMember(cid) {
      return signedIn()
        && exists(/databases/$(database)/documents/messages/$(cid))
        && hasMember(get(/databases/$(database)/documents/messages/$(cid)).data.memberUids);
    }

    function inviteInvolvesUser(data) {
      return data != null && (
        (data.fromUid != null && request.auth.uid == data.fromUid) ||
        (data.toUid != null && request.auth.uid == data.toUid)
      );
    }

    match /usersPrivate/{uid} {
      allow create: if isOwnerUid(uid);
      allow read, update, delete: if isOwnerUid(uid) || isAdmin();

      match /{subCollection=**} {
        allow read, write: if isOwnerUid(uid) || isAdmin();
      }
    }

    match /usersPublic/{uid} {
      allow read: if signedIn();
      allow create: if isOwnerUid(uid) || isAdmin();
      allow update, delete: if isOwnerUid(uid) || isAdmin();

      match /{subCollection=**} {
        allow read, write: if isOwnerUid(uid) || isAdmin();
      }
    }

    match /users/{uid} {
      allow create: if isOwnerUid(uid) || isAdmin();
      allow read: if signedIn();
      allow update, delete: if isOwnerUid(uid) || isAdmin();
    }

    match /userHandles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /userSearchIndex/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /posts/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if ownerMatchesResource()
        || ownerMatchesRequest()
        || (
          signedIn()
          && resource != null
          && request.resource != null
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.pid == resource.data.pid
          && request.resource.data.handle == resource.data.handle
          && request.resource.data.pfp == resource.data.pfp
          && request.resource.data.caption == resource.data.caption
          && request.resource.data.workout == resource.data.workout
          && request.resource.data.media == resource.data.media
          && request.resource.data.images == resource.data.images
          && request.resource.data.sortKey == resource.data.sortKey
          && request.resource.data.created == resource.data.created
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == resource.data.updatedAt
          && request.resource.data.tags == resource.data.tags
          && request.resource.data.tagged == resource.data.tagged
          && request.resource.data.keys().hasOnly(resource.data.keys())
        )
        || isAdmin();
    }

    match /workouts/{wid} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn()
        && (
          ownerMatchesResource()
          || ownerMatchesRequest()
          || (request.resource.data.members != null
            && asList(request.resource.data.members).hasAny([request.auth.uid]))
          || isAdmin()
        );
      allow delete: if ownerMatchesResource() || isAdmin();

      match /live/{participantUid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == participantUid;
        allow delete: if (signedIn() && request.auth.uid == participantUid) || isAdmin();
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn()
          && request.resource.data.uid == request.auth.uid;
      }
    }

    match /workoutInvites/{inviteId} {
      allow create: if signedIn() && inviteInvolvesUser(request.resource.data);
      allow read: if signedIn() && (
        inviteInvolvesUser(resource.data) ||
        (request.resource != null && inviteInvolvesUser(request.resource.data))
      );
      allow update, delete: if signedIn() && (
        inviteInvolvesUser(resource.data) ||
        (request.resource != null && inviteInvolvesUser(request.resource.data)) ||
        isAdmin()
      );
    }

    match /messages/{cid} {
      function memberInResource() {
        return resource != null && hasMember(resource.data.memberUids);
      }

      function memberInRequest() {
        return request.resource != null && hasMember(request.resource.data.memberUids);
      }

      allow create: if signedIn() && memberInRequest();
      allow read: if signedIn() && (memberInResource() || memberInRequest());
      allow update, delete: if signedIn() && (memberInResource() || memberInRequest() || isAdmin());

      match /content/{mid} {
        allow create: if signedIn() && isChatMember(cid);
        allow read: if signedIn() && isChatMember(cid);
        allow update, delete: if signedIn() && (isChatMember(cid) || ownerMatchesResource() || ownerMatchesRequest() || isAdmin());
      }
    }

    match /tribes/{tribeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && (
        request.auth.uid == resource.data.ownerUid ||
        (request.resource != null && request.auth.uid == request.resource.data.ownerUid) ||
        isAdmin()
      );
    }

    match /leaderboardMeta/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /leaderboardSnapshots/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /global/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
