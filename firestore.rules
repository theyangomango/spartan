rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    function ownerFrom(data) {
      return data.uid != null ? data.uid :
        data.ownerUid != null ? data.ownerUid :
        data.userUid != null ? data.userUid :
        data.creatorUid != null ? data.creatorUid :
        data.createdByUid != null ? data.createdByUid :
        null;
    }

    function isOwnerUid(uid) {
      return uid != null && signedIn() && request.auth.uid == uid;
    }

    function ownerMatchesResource() {
      return resource != null && isOwnerUid(ownerFrom(resource.data));
    }

    function ownerMatchesRequest() {
      return request.resource != null && isOwnerUid(ownerFrom(request.resource.data));
    }

    function asList(value) {
      return value is list ? value : [];
    }

    function hasMember(listValue) {
      return signedIn() && asList(listValue).hasAny([request.auth.uid]);
    }

    function isWorkoutMember(data) {
      return signedIn()
        && data != null
        && (
          (data.members != null && asList(data.members).hasAny([request.auth.uid]))
          || (data.users != null && asList(data.users).hasAny([request.auth.uid]))
        );
    }

    function actorMatchesAuth(data) {
      return signedIn()
        && data != null
        && (
          (data.uid != null && request.auth.uid == data.uid)
          || (data.fromUid != null && request.auth.uid == data.fromUid)
          || (data.userUid != null && request.auth.uid == data.userUid)
        );
    }

    function isChatMember(cid) {
      return signedIn()
        && exists(/databases/$(database)/documents/messages/$(cid))
        && hasMember(get(/databases/$(database)/documents/messages/$(cid)).data.memberUids);
    }

    function inviteInvolvesUser(data) {
      return data != null && (
        (data.fromUid != null && request.auth.uid == data.fromUid) ||
        (data.toUid != null && request.auth.uid == data.toUid)
      );
    }

    function allowWorkoutPatch() {
      return signedIn()
        && resource != null
        && request.auth.uid == resource.data.uid
        && request.writeFields.hasOnly(['workout', 'updatedAt', 'workoutDeletedAt']);
    }

    function allowPostLikeUpdate() {
      return signedIn()
        && resource != null
        && request.writeFields.hasOnly(['likes', 'likeCount'])
        && request.resource.data.keys().hasAll(['likes', 'likeCount'])
        && request.resource.data.likes is list
        && (
          request.resource.data.likeCount is int
          || request.resource.data.likeCount is float
        )
        && request.resource.data.likeCount >= 0
        && request.resource.data.likeCount == request.resource.data.likes.size();
    }

    function allowPostCommentUpdate() {
      return signedIn()
        && resource != null
        && request.writeFields.hasOnly(['comments', 'commentCount'])
        && (
          !request.writeFields.hasAny(['comments'])
          || (
            request.resource.data.comments is list
            && (
              !('comments' in resource.data)
              || (
                resource.data.comments is list
              )
            )
          )
        )
        && (
          !request.writeFields.hasAny(['commentCount'])
          || (
            (
              request.resource.data.commentCount is int
              || request.resource.data.commentCount is float
            )
            && request.resource.data.commentCount >= 0
            && (
              !('commentCount' in resource.data)
              || !(resource.data.commentCount is int || resource.data.commentCount is float)
              || request.resource.data.commentCount == resource.data.commentCount
              || request.resource.data.commentCount == resource.data.commentCount + 1
              || request.resource.data.commentCount + 1 == resource.data.commentCount
            )
          )
        );
    }

    function sameMembers(listA, listB) {
      return listA.size() == listB.size()
        && listA.hasAll(listB)
        && listB.hasAll(listA);
    }

    function tribeHasMember(data) {
      return data != null
        && (
          (data.members != null && hasMember(data.members))
          || (data.memberIds != null && hasMember(data.memberIds))
        );
    }

    function memberCanEditTribeComparisons() {
      return signedIn()
        && request.writeFields.hasOnly(['comparisons', 'comparison', 'updatedAt'])
        && (
          (resource != null && tribeHasMember(resource.data))
          || (request.resource != null && tribeHasMember(request.resource.data))
        );
    }

    function canUpdateTribeMembership() {
      let before = resource != null ? asList(resource.data.members) : [];
      let after = request.resource != null ? asList(request.resource.data.members) : [];

      let addedSelf = after.size() == before.size() + 1
        && after.hasAll(before)
        && after.hasAny([request.auth.uid])
        && !before.hasAny([request.auth.uid]);
      let removedSelf = before.size() == after.size() + 1
        && before.hasAll(after)
        && before.hasAny([request.auth.uid])
        && !after.hasAny([request.auth.uid]);
      let unchanged = sameMembers(before, after);

      return signedIn()
        && resource != null
        && request.resource != null
        && request.writeFields.hasOnly(['members', 'updatedAt'])
        && after is list
        && before is list
        && (unchanged || addedSelf || removedSelf);
    }

    match /usersPrivate/{uid} {
      allow create: if isOwnerUid(uid);
      allow read, update, delete: if isOwnerUid(uid) || isAdmin();

      match /{subCollection=**} {
        allow read, write: if isOwnerUid(uid) || isAdmin();
      }
    }

    match /usersPublic/{uid} {
      allow read: if signedIn();
      allow create: if isOwnerUid(uid) || isAdmin();
      allow update, delete: if isOwnerUid(uid) || isAdmin();

      match /{subCollection=**} {
        allow read, write: if isOwnerUid(uid) || isAdmin();
      }
    }

    match /users/{uid} {
      allow create: if isOwnerUid(uid) || isAdmin();
      allow read: if signedIn();
      allow update, delete: if isOwnerUid(uid) || isAdmin();
    }

    match /userSignals/{uid} {
      allow create: if isOwnerUid(uid);
      allow read, update, delete: if isOwnerUid(uid) || isAdmin();

      match /{subCollection=**} {
        allow read, write: if isOwnerUid(uid) || isAdmin();
      }
    }

    match /userHandles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /userSearchIndex/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /posts/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if ownerMatchesResource()
        || ownerMatchesRequest()
        || allowPostLikeUpdate()
        || allowPostCommentUpdate()
        || allowWorkoutPatch()
        || isAdmin();
    }

    match /workouts/{wid} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn()
        && (
          ownerMatchesResource()
          || ownerMatchesRequest()
          || (request.resource != null && isWorkoutMember(request.resource.data))
          || (resource != null && isWorkoutMember(resource.data))
          || isAdmin()
        );
      allow delete: if ownerMatchesResource() || isAdmin();

      match /live/{participantUid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == participantUid;
        allow delete: if (signedIn() && request.auth.uid == participantUid) || isAdmin();
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow create, update, delete: if (request.resource != null && actorMatchesAuth(request.resource.data))
          || (resource != null && actorMatchesAuth(resource.data))
          || isAdmin();
      }
    }

    match /workoutInvites/{inviteId} {
      allow create: if signedIn() && inviteInvolvesUser(request.resource.data);
      allow read: if signedIn() && (
        inviteInvolvesUser(resource.data) ||
        (request.resource != null && inviteInvolvesUser(request.resource.data))
      );
      allow update, delete: if signedIn() && (
        inviteInvolvesUser(resource.data) ||
        (request.resource != null && inviteInvolvesUser(request.resource.data)) ||
        isAdmin()
      );
    }

    match /messages/{cid} {
      function memberInResource() {
        return resource != null && hasMember(resource.data.memberUids);
      }

      function memberInRequest() {
        return request.resource != null && hasMember(request.resource.data.memberUids);
      }

      allow create: if signedIn() && memberInRequest();
      allow read: if signedIn() && (memberInResource() || memberInRequest());
      allow update, delete: if signedIn() && (memberInResource() || memberInRequest() || isAdmin());

      match /content/{mid} {
        allow create: if signedIn() && isChatMember(cid);
        allow read: if signedIn() && isChatMember(cid);
        allow update, delete: if signedIn() && (isChatMember(cid) || ownerMatchesResource() || ownerMatchesRequest() || isAdmin());
      }
    }

    match /tribes/{tribeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.ownerUid ||
        (request.resource != null && request.auth.uid == request.resource.data.ownerUid) ||
        isAdmin() ||
        canUpdateTribeMembership() ||
        memberCanEditTribeComparisons()
      );
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.ownerUid ||
        (request.resource != null && request.auth.uid == request.resource.data.ownerUid) ||
        isAdmin()
      );
    }

    match /leaderboardMeta/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /leaderboardSnapshots/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /global/{docId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if signedIn()
        && resource != null
        && request.resource != null
        && request.resource.data.keys().hasOnly(resource.data.keys())
        && (
          !('PIDs' in resource.data)
          || (
            request.resource.data.PIDs is list
            && resource.data.PIDs is list
            && request.resource.data.PIDs.size() <= resource.data.PIDs.size()
            && resource.data.PIDs.hasAll(request.resource.data.PIDs)
          )
        );
    }

    match /globalTrendingPosts/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
